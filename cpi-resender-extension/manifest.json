{
  "name": "CPI - Resender",
  "short_name": "CPI Resender",
  "version": "0.1.0",
  "description": "Minimal CPI helper: lists iFlows with counts of recent Completed/Failed messages.",
  "manifest_version": 3,
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.hana.ondemand.com/itspaces",
    "https://*.platform.sapcloud.cn/itspaces",
    "https://*.hana.ondemand.com/shell",
    "https://*.platform.sapcloud.cn/shell"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hana.ondemand.com/itspaces/*",
        "https://*.platform.sapcloud.cn/itspaces/*",
        "https://*.hana.ondemand.com/shell/*",
        "https://*.platform.sapcloud.cn/shell/*"
      ],
      "js": [
        "lib/xmlToJson/xmlToJson.js",
        "scripts/contentBridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/xmlToJson/xmlToJson.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
